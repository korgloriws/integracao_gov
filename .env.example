AWS_API_KEY=
# Chave x-api-key do S3 / upload (API_URL). Permanece como AWS_API_KEY.
API_URL=https://v60yr1ma4f.execute-api.sa-east-1.amazonaws.com/prod/upload-arquivos

BANCO_API_KEY=
# Chave x-api-key da API Banco (listar-arquivos).
# Se ficar vazia, o sistema reutiliza a AWS_API_KEY automaticamente.
BANCO_API_URL=https://v60yr1ma4f.execute-api.sa-east-1.amazonaws.com/prod/listar-arquivos

APP_PORT=3080

# --- Docker: caminho do share NO HOST (montado em /mnt/sefaz dentro do container) ---
# Linux VPS (padrão): monte CIFS com scripts/montar-share-sefaz.sh
SEFAZ_SHARE_HOST_PATH=/mnt/sefaz

# Windows Docker Desktop: use Z:/ após scripts\montar-share-sefaz.ps1
# SEFAZ_SHARE_HOST_PATH=Z:/

# --- uvicorn local no Windows (sem Docker) ---
# Não defina SEFAZ_SHARE_HOST_PATH nem SEFAZ_SHARE_ROOT
# (usa UNC \\10.129.1.254\sefas - sufin automaticamente)

GOV_BASE_URL=https://webapp1-contagem.cidade360.cloud/CustomData.Api
GOV_IDENTIFICADOR=
GOV_SENHA=
GOV_EMAIL=
